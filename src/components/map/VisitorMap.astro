<div id="visitor-map" style="min-height:420px" class="w-full rounded-xl border bg-muted overflow-hidden z-0 relative">
  <p id="map-loading" class="absolute inset-0 flex items-center justify-center text-muted-foreground text-sm z-10 pointer-events-none">Loading map...</p>
</div>

<script>
  fetch('https://api.ru00ys-lab.com/track', { method: 'GET' }).catch(() => {})
</script>

<script is:inline>
  (function() {
    var link = document.createElement('link')
    link.rel = 'stylesheet'
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
    document.head.appendChild(link)

    var s = document.createElement('script')
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
    s.onload = function() {
      var container = document.getElementById('visitor-map')
      if (!container) return

      var map = L.map('visitor-map', {
        center: [15, 0],
        zoom: 2,
        minZoom: 2,
        maxZoom: 18,
        scrollWheelZoom: false,
        zoomControl: true,
        zoomControlOptions: { position: 'bottomright' },
      })

      // Standard world map with English labels
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(map)

      // Remove loading text
      var loading = document.getElementById('map-loading')
      if (loading) loading.remove()

      fetch('https://api.ru00ys-lab.com/data')
        .then(function(r) { return r.json() })
        .then(function(visitors) {
          if (!visitors.length) return

          var markers = []
          visitors.forEach(function(v) {
            if (!v.lat || !v.lon) return
            var key = Math.round(v.lat * 10) / 10 + ',' + Math.round(v.lon * 10) / 10
            var existing = markers.find(function(m) { return m.key === key })
            if (existing) { existing.count++ }
            else { markers.push({ key: key, lat: v.lat, lon: v.lon, city: v.city, country: v.country, count: 1 }) }
          })

          markers.forEach(function(m) {
            var radius = Math.min(4 + m.count * 2, 14)
            var label = m.city ? m.city + ', ' + m.country : m.country
            L.circleMarker([m.lat, m.lon], {
              radius: radius,
              fillColor: 'hsl(207, 60%, 42%)',
              color: 'hsl(207, 60%, 42%)',
              weight: 1,
              opacity: 0.6,
              fillOpacity: 0.4,
            })
              .bindTooltip(label + ' (' + m.count + ')', { direction: 'top', offset: [0, -radius] })
              .addTo(map)
          })
        })
        .catch(function() {})
    }
    document.head.appendChild(s)
  })()
</script>
