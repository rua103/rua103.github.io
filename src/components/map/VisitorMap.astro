<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<div id="visitor-map" class="w-full h-72 rounded-xl border bg-muted overflow-hidden z-0">
  <div class="flex items-center justify-center h-full text-muted-foreground text-sm">
    Loading map...
  </div>
</div>

<script>
  // Track this visit
  fetch('https://api.ru00ys-lab.com/track', { method: 'GET' }).catch(() => {})

  async function initMap() {
    const L = (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')).default
    const container = document.getElementById('visitor-map')
    if (!container) return

    // Create map
    container.innerHTML = ''
    const map = L.map('visitor-map', {
      center: [20, 0],
      zoom: 2,
      scrollWheelZoom: false,
      zoomControl: false,
      attributionControl: false,
    })

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19,
    }).addTo(map)

    // Fetch visitor data
    try {
      const res = await fetch('https://api.ru00ys-lab.com/data')
      const visitors = await res.json()

      if (visitors.length === 0) {
        container.innerHTML += '<p class="text-xs text-muted-foreground text-center py-4">No visitors yet — you might be the first!</p>'
        return
      }

      // Group nearby visitors to reduce clutter
      const markers = []
      for (const v of visitors) {
        if (v.lat && v.lon) {
          const key = `${Math.round(v.lat * 10) / 10},${Math.round(v.lon * 10) / 10}`
          const existing = markers.find(m => m.key === key)
          if (existing) {
            existing.count++
          } else {
            markers.push({ key, lat: v.lat, lon: v.lon, city: v.city, country: v.country, count: 1 })
          }
        }
      }

      // Add circle markers
      for (const m of markers) {
        const radius = Math.min(4 + m.count * 2, 14)
        const label = m.city ? `${m.city}, ${m.country}` : m.country
        L.circleMarker([m.lat, m.lon], {
          radius,
          fillColor: 'hsl(207, 60%, 42%)',
          color: 'hsl(207, 60%, 42%)',
          weight: 1,
          opacity: 0.6,
          fillOpacity: 0.35,
        })
          .bindTooltip(`${label} (${m.count})`, { direction: 'top', offset: [0, -radius] })
          .addTo(map)
      }

      // Fit bounds
      if (markers.length === 1) {
        map.setView([markers[0].lat, markers[0].lon], 6)
      } else if (markers.length > 1) {
        const bounds = L.latLngBounds(markers.map(m => [m.lat, m.lon]))
        map.fitBounds(bounds.pad(0.3))
      }
    } catch (_) {
      container.innerHTML += '<p class="text-xs text-muted-foreground text-center py-4">Map data not available right now.</p>'
    }
  }

  // Defer map init to avoid blocking page render
  setTimeout(initMap, 1200)
</script>

<style>
  #visitor-map {
    min-height: 280px;
  }
  #visitor-map .leaflet-control-attribution {
    font-size: 9px;
  }
</style>
