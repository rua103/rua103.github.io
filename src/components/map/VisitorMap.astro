---
// World base map is rendered to static SVG at build time using a simple
// equirectangular projection. No runtime d3 / topojson / CDN dependency —
// the outline always shows, even if the visitor data request fails.
import worldDataRaw from './world-110m.json'

// countries[country][polygon][ring][point] = [lon, lat]
const countries = worldDataRaw as unknown as number[][][][][]

const W = 1000
const H = 500

const projectX = (lon: number) => ((lon + 180) / 360) * W
const projectY = (lat: number) => ((90 - lat) / 180) * H

function buildCountryPath(country: number[][][][]): string {
  let d = ''
  for (const polygon of country) {
    for (const ring of polygon) {
      for (let i = 0; i < ring.length; i++) {
        const x = projectX(ring[i][0]).toFixed(1)
        const y = projectY(ring[i][1]).toFixed(1)
        d += (i === 0 ? 'M' : 'L') + x + ',' + y
      }
      d += 'Z'
    }
  }
  return d
}

const countryPaths = countries.map(buildCountryPath).filter((d) => d.length > 0)

// Graticule (subtle reference grid) — straight lines under equirectangular.
const meridians: number[] = []
for (let lon = -150; lon <= 150; lon += 30) meridians.push(projectX(lon))
const parallels: number[] = []
for (let lat = -60; lat <= 60; lat += 30) parallels.push(projectY(lat))
---

<div class='visitor-map' aria-label='Visitor world map'>
  <svg
    id='visitor-world-map'
    class='visitor-world-map'
    viewBox={`0 0 ${W} ${H}`}
    role='img'
    preserveAspectRatio='xMidYMid meet'
  >
    <defs>
      <linearGradient id='visitor-land-gradient' x1='0' y1='0' x2='1' y2='1'>
        <stop offset='0%' class='visitor-land-stop-start' />
        <stop offset='100%' class='visitor-land-stop-end' />
      </linearGradient>
      <radialGradient id='visitor-point-glow' cx='50%' cy='50%' r='50%'>
        <stop offset='0%' stop-color='hsl(195, 100%, 75%)' stop-opacity='0.55' />
        <stop offset='100%' stop-color='hsl(195, 100%, 75%)' stop-opacity='0' />
      </radialGradient>
    </defs>
    <g class='visitor-map-graticule'>
      {meridians.map((x) => <line x1={x} y1={0} x2={x} y2={H} />)}
      {parallels.map((y) => <line x1={0} y1={y} x2={W} y2={y} />)}
    </g>
    <g class='visitor-map-countries'>
      {countryPaths.map((d) => <path d={d} class='visitor-map-country' />)}
    </g>
    <g id='visitor-map-points'></g>
  </svg>
  <p id='map-status' class='visitor-map-status'>Loading visitors...</p>
</div>

<script is:inline define:vars={{ W, H }}>
  ;(function () {
    var status = document.getElementById('map-status')
    var pointLayer = document.getElementById('visitor-map-points')
    if (!pointLayer) return

    function projectX(lon) {
      return ((lon + 180) / 360) * W
    }
    function projectY(lat) {
      return ((90 - lat) / 180) * H
    }

    function createSvgElement(name, attrs) {
      var element = document.createElementNS('http://www.w3.org/2000/svg', name)
      Object.keys(attrs || {}).forEach(function (key) {
        element.setAttribute(key, attrs[key])
      })
      return element
    }

    function groupVisitors(visitors) {
      var groups = {}
      visitors.forEach(function (visitor) {
        var lat = Number(visitor.lat)
        var lon = Number(visitor.lon)
        if (!Number.isFinite(lat) || !Number.isFinite(lon)) return

        var key = Math.round(lat * 2) / 2 + ',' + Math.round(lon * 2) / 2
        if (groups[key]) {
          groups[key].count += 1
          return
        }
        groups[key] = {
          lat: lat,
          lon: lon,
          city: visitor.city,
          region: visitor.region,
          country: visitor.country,
          count: 1
        }
      })
      return Object.keys(groups).map(function (key) {
        return groups[key]
      })
    }

    function setStatus(text) {
      if (!status) return
      if (!text) {
        status.remove()
        status = null
        return
      }
      status.textContent = text
    }

    function drawVisitors(visitors) {
      pointLayer.replaceChildren()
      var groups = groupVisitors(visitors)
      if (!groups.length) {
        setStatus('No visitors yet.')
        return
      }

      groups.forEach(function (visitor) {
        var x = projectX(visitor.lon)
        var y = projectY(visitor.lat)
        var count = visitor.count
        var radius = Math.min(4 + Math.sqrt(count) * 2.2, 13)
        var label =
          [visitor.city, visitor.region, visitor.country].filter(Boolean).join(', ') || 'Visitor'

        // Pulsing halo. Visual attributes set directly (Astro scoped CSS
        // does not reach runtime-created SVG nodes), animation via global CSS.
        pointLayer.appendChild(
          createSvgElement('circle', {
            cx: x,
            cy: y,
            r: radius * 2.8,
            fill: 'url(#visitor-point-glow)',
            'pointer-events': 'none',
            class: 'visitor-point-glow'
          })
        )

        var marker = createSvgElement('circle', {
          cx: x,
          cy: y,
          r: radius,
          fill: 'hsl(200, 100%, 92%)',
          stroke: 'hsl(207, 88%, 46%)',
          'stroke-width': 2.4,
          'vector-effect': 'non-scaling-stroke',
          class: 'visitor-point'
        })
        var title = createSvgElement('title', {})
        title.textContent = label + ' (' + count + ')'
        marker.appendChild(title)
        pointLayer.appendChild(marker)
      })

      setStatus('')
    }

    fetch('https://api.ru00ys-lab.com/data', { cache: 'no-store' })
      .then(function (response) {
        if (!response.ok) throw new Error('Visitor data failed')
        return response.json()
      })
      .then(function (data) {
        drawVisitors(Array.isArray(data) ? data : [])
      })
      .catch(function () {
        // Base map still shows; just clear the loading hint.
        setStatus('')
      })
  })()
</script>

<style>
  .visitor-map {
    position: relative;
    width: 100%;
  }

  .visitor-world-map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .visitor-map-graticule line {
    stroke: hsl(var(--muted-foreground) / 0.12);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }

  .visitor-land-stop-start {
    stop-color: hsl(var(--primary));
  }

  .visitor-land-stop-end {
    stop-color: hsl(200 80% 70%);
  }

  .visitor-map-country {
    fill: url(#visitor-land-gradient);
    fill-opacity: 0.75;
    stroke: hsl(var(--background));
    stroke-width: 0.85;
    vector-effect: non-scaling-stroke;
  }

  .visitor-map-status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    pointer-events: none;
  }
</style>

<style is:global>
  /* Runtime-created points live outside Astro's scoped CSS, so target them globally. */
  #visitor-map-points .visitor-point {
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.18s ease,
      filter 0.18s ease;
  }

  #visitor-map-points .visitor-point:hover {
    transform: scale(1.45);
    filter: drop-shadow(0 0 6px hsl(195 100% 70% / 0.9));
  }

  #visitor-map-points .visitor-point-glow {
    transform-box: fill-box;
    transform-origin: center;
    animation: visitor-pulse 2.6s ease-in-out infinite;
  }

  @keyframes visitor-pulse {
    0%,
    100% {
      transform: scale(0.85);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #visitor-map-points .visitor-point-glow {
      animation: none;
    }
    #visitor-map-points .visitor-point {
      transition: none;
    }
  }
</style>
