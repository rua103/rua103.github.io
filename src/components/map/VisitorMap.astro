<div id="visitor-map" style="min-height:280px" class="w-full h-72 rounded-xl border bg-muted overflow-hidden z-0">
  <p class="flex items-center justify-center h-full text-muted-foreground text-sm">Loading map...</p>
</div>

<script>
  // Track this visit
  fetch('https://api.ru00ys-lab.com/track', { method: 'GET' }).catch(() => {})
</script>

<script is:inline>
  (function() {
    var link = document.createElement('link')
    link.rel = 'stylesheet'
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
    document.head.appendChild(link)

    var script = document.createElement('script')
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
    script.onload = function() {
      var container = document.getElementById('visitor-map')
      if (!container) return

      var map = L.map('visitor-map', {
        center: [20, 0],
        zoom: 2,
        scrollWheelZoom: false,
        zoomControl: false,
        attributionControl: false,
      })

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
      }).addTo(map)

      fetch('https://api.ru00ys-lab.com/data')
        .then(function(r) { return r.json() })
        .then(function(visitors) {
          if (!visitors.length) {
            container.querySelector('p').textContent = 'No visitors yet!'
            return
          }

          var markers = []
          visitors.forEach(function(v) {
            if (!v.lat || !v.lon) return
            var key = Math.round(v.lat * 10) / 10 + ',' + Math.round(v.lon * 10) / 10
            var existing = markers.find(function(m) { return m.key === key })
            if (existing) { existing.count++ }
            else { markers.push({ key: key, lat: v.lat, lon: v.lon, city: v.city, country: v.country, count: 1 }) }
          })

          container.querySelector('p').remove()

          markers.forEach(function(m) {
            var radius = Math.min(4 + m.count * 2, 14)
            var label = m.city ? m.city + ', ' + m.country : m.country
            L.circleMarker([m.lat, m.lon], {
              radius: radius,
              fillColor: 'hsl(207, 60%, 42%)',
              color: 'hsl(207, 60%, 42%)',
              weight: 1,
              opacity: 0.6,
              fillOpacity: 0.35,
            })
              .bindTooltip(label + ' (' + m.count + ')', { direction: 'top', offset: [0, -radius] })
              .addTo(map)
          })

          if (markers.length === 1) {
            map.setView([markers[0].lat, markers[0].lon], 6)
          } else if (markers.length > 1) {
            var bounds = L.latLngBounds(markers.map(function(m) { return [m.lat, m.lon] }))
            map.fitBounds(bounds.pad(0.3))
          }
        })
        .catch(function() {
          container.querySelector('p').textContent = 'Map data not available right now.'
        })
    }
    document.head.appendChild(script)
  })()
</script>
