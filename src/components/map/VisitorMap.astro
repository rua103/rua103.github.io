<div id="visitor-map" style="min-height:380px" class="w-full rounded-xl border bg-muted overflow-hidden relative z-0">
  <p id="map-status" class="absolute inset-0 flex items-center justify-center text-muted-foreground text-sm z-10">Loading map...</p>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script is:inline>
  (function() {
    var script = document.createElement('script')
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
    script.onload = function() {
      var container = document.getElementById('visitor-map')
      if (!container) return
      var status = document.getElementById('map-status')

      var map = L.map('visitor-map', {
        center: [20, 0], zoom: 2,
        minZoom: 2, maxZoom: 2,
        scrollWheelZoom: false,
        doubleClickZoom: false,
        touchZoom: false,
        dragging: false,
        keyboard: false,
        zoomControl: false,
        attributionControl: false,
      })

      // Clean world map tiles — CartoDB Voyager (no key needed, fast CDN)
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png', {
        maxZoom: 2,
      }).addTo(map)

      fetch('https://api.ru00ys-lab.com/data')
        .then(function(r) { return r.json() })
        .then(function(visitors) {
          if (!visitors.length) { status.textContent = 'No visitors yet!'; return }
          status.remove()

          var groups = {}
          visitors.forEach(function(v) {
            if (!v.lat) return
            var k = Math.round(v.lat * 2) / 2 + ',' + Math.round(v.lon * 2) / 2
            if (groups[k]) { groups[k].count++ }
            else { groups[k] = { lat: v.lat, lon: v.lon, city: v.city, region: v.region, country: v.country, count: 1 } }
          })

          Object.values(groups).forEach(function(v) {
            var r = Math.min(5 + v.count * 1.5, 14)
            var label = [v.city, v.region, v.country].filter(Boolean).join(', ')
            L.circleMarker([v.lat, v.lon], {
              radius: r,
              fillColor: 'hsl(207, 65%, 48%)',
              color: '#fff',
              weight: 1,
              opacity: 0.9,
              fillOpacity: 0.7,
            })
              .bindTooltip(label + ' (' + v.count + ')', { direction: 'top', offset: [0, -r] })
              .addTo(map)
          })
        })
        .catch(function() { status.textContent = 'Map not available.' })
    }
    document.head.appendChild(script)
  })()
</script>
