<script>
  const MAX_SCALE = 1.12
  const MIN_SCALE = 0.97
  const RADIUS = 180
  const ITEMS = '.bg-muted'

  function magnify(e: MouseEvent) {
    const cards = Array.from(document.querySelectorAll(ITEMS)) as HTMLElement[]
    cards.forEach((card) => {
      const rect = card.getBoundingClientRect()
      const cx = rect.left + rect.width / 2
      const cy = rect.top + rect.height / 2
      const dx = e.clientX - cx
      const dy = e.clientY - cy
      const dist = Math.sqrt(dx * dx + dy * dy)

      // Normalized distance: 0 = cursor on card, 1 = at RADIUS edge
      const t = Math.max(0, 1 - dist / RADIUS)

      // Closer → magnify, farther → subtly shrink
      // Power of 5 for sharp peak — only the card under cursor really pops
      const scale = t > 0.1
        ? 1 + (MAX_SCALE - 1) * Math.pow(t, 5)
        : MIN_SCALE

      const shadow = 8 + 32 * t * t

      // Brightness & border: brighter when hit, dim when far
      const brightness = t > 0.1
        ? 1 + 0.12 * t
        : 0.88
      const borderAlpha = t > 0.1
        ? 0.18 + 0.5 * t       // border glows on hit
        : 0.18

      card.style.transform = `scale(${scale})`
      card.style.boxShadow = `0 ${shadow}px ${shadow * 2}px hsl(var(--background) / ${0.08 + 0.2 * t})`
      card.style.filter = `brightness(${brightness})`
      card.style.borderColor = `hsl(var(--primary) / ${borderAlpha})`
      card.style.transition = 'transform 0.15s ease-out, box-shadow 0.15s ease-out, filter 0.15s ease-out, border-color 0.15s ease-out'
    })
  }

  document.addEventListener('mousemove', magnify, { passive: true })
</script>
