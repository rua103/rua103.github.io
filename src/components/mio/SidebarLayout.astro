---
// Sidebar-as-record-sleeve: sticky left sidebar with vertical art strip,
// wordmark, tracklist nav, and now-playing player docked at bottom.
// Matches the Night Session v0 canonical design.
---

<div class='ns-shell'>
  <aside class='ns-sidebar'>
    <div class='ns-side-art'></div>
    <div class='ns-side-inner'>
      <a href='/' class='ns-wordmark'>Ru00y.</a>
      <div class='ns-role'>VLM Research &middot; Field Notes</div>

      <nav class='ns-nav'>
        <a href='/blog'><span class='num'>01</span><span class='trk'>Writing</span></a>
        <a href='/projects'><span class='num'>02</span><span class='trk'>Projects</span></a>
        <a href='/publications'><span class='num'>03</span><span class='trk'>Publications</span></a>
        <a href='/about'><span class='num'>04</span><span class='trk'>About</span></a>
        <a href='/connect'><span class='num'>05</span><span class='trk'>Connect</span></a>
        <a href='https://github.com/rua103' target='_blank'><span class='num'>06</span><span class='trk'>GitHub</span></a>
      </nav>

      <a href='/listening' class='ns-player'>
        <div class='ns-np-label'>
          <span class='ns-eq'><i></i><i></i><i></i><i></i></span>
          <span id='np-state'>Now playing</span>
        </div>
        <div class='ns-np-track' id='np-track'>Wish You Were Here</div>
        <div class='ns-np-artist'>by <b id='np-artist'>Pink Floyd</b></div>
      </a>
    </div>
  </aside>

  <main class='ns-main'>
    <slot />
  </main>
</div>

<script>
  const LASTFM_USER = 'Ru00y'
  const LASTFM_KEY  = '189a78aa47d5f4d7602ac0e5a1e1ea41'
  let lastTrack = ''
  let lastArtist = ''

  async function pullNowPlaying() {
    try {
      const url = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${LASTFM_USER}&api_key=${LASTFM_KEY}&format=json&limit=1`
      const r = await fetch(url); const d = await r.json()
      const t = d.recenttracks?.track?.[0]; if (!t) return
      const live = t['@attr']?.nowplaying === 'true'
      const name = t.name
      const artist = t.artist['#text']
      if (name === lastTrack && artist === lastArtist) return // no change
      lastTrack = name; lastArtist = artist
      const stateEl = document.getElementById('np-state')
      const trackEl = document.getElementById('np-track')
      const artistEl = document.getElementById('np-artist')
      if (stateEl) stateEl.textContent = live ? 'Now playing' : 'Last played'
      if (trackEl) trackEl.textContent = name
      if (artistEl) artistEl.textContent = artist
    } catch (e) { /* keep fallback */ }
  }

  pullNowPlaying()
  setInterval(pullNowPlaying, 30000) // refresh every 30s
</script>
