---
import PageLayout from '@/layouts/BaseLayout.astro'
import { Comment } from '@/components/giscus'
import VisitorMap from '@/components/map/VisitorMap.astro'
import rawFriends from '../../data/friends.json'

interface Friend {
  name: string
  link: string
  avatar: string
  desc: string
}

const friends = rawFriends as Friend[]

// Fisher-Yates shuffle
function shuffle<T>(arr: T[]): T[] {
  const a = [...arr]
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))
    ;[a[i], a[j]] = [a[j], a[i]]
  }
  return a
}

const shuffled = shuffle(friends)
---

<PageLayout meta={{ title: 'Connect' }}>
  <main class='flex w-full flex-col items-center py-12'>
    <div class='w-full animate flex flex-col gap-y-12 md:w-4/5 lg:w-5/6'>

      <!-- Header -->
      <div class='text-center'>
        <h1 class='text-3xl font-bold gradient-text mb-2'>Connect</h1>
        <p class='text-muted-foreground'>Stay updated. Meet friends.</p>
      </div>

      <!-- Subscribe -->
      <section>
        <h2 class='text-xl font-semibold text-foreground mb-2'>
          Subscribe
          <a href="https://api.ru00ys-lab.com/login" class="text-muted-foreground/20 hover:text-primary transition-colors text-xs ml-1.5 align-middle select-none" title="Owner" tabindex="-1">🔒</a>
        </h2>
        <p class='text-muted-foreground text-sm mb-4'>Get new posts delivered to your inbox.</p>
        <form
          action="https://api.follow.it/subscription-form/NGxBMDlLU3o3MGZPNnRpZXJJNWcwaDIwTlhnYzJXaWQrUysycGpDY2hYRTZJOWR3VXVzOU9EUUVwTFY4dnJoZnpCN2RCV3NlVGlIU3lKekhLNTdJK3FJUmRobUo2SlJIbGw5SEtBY0lKdVl4ZE1yYW93VXAxR283K3VKUkk4cVd8VXRyRVlBTG52ZWRCTGptZ2VsREUzcWYxcEt4ZWs2L2c5cXFLRU9NOGE1VT0=/8"
          method="post"
          target="_blank"
          novalidate
          class='flex items-stretch gap-x-3'
        >
          <input
            type="email"
            name="email"
            id="email"
            required
            aria-describedby="email-error"
            placeholder="Enter your email"
            class="flex-1 h-11 rounded-xl border bg-muted px-4 text-sm outline-none focus:border-primary transition-all active:scale-[0.99]"
          />
          <button
            type="submit"
            class="h-11 rounded-xl bg-foreground text-background font-semibold text-sm px-6 hover:opacity-85 active:scale-95 transition-all whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
        <p id="email-error" class="hidden text-red-500 text-xs mt-1.5"></p>
        <p class="text-muted-foreground text-xs mt-2">
          Powered by <a href="https://follow.it" class="underline" target="_blank">follow.it</a>
        </p>

        <!-- Owner-only subscriber panel -->
        <div id="subscriber-panel" class="hidden mt-6">
          <div class="rounded-xl border bg-muted p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-foreground">Subscribers</h3>
              <span id="subscriber-count" class="text-sm text-muted-foreground"></span>
            </div>
            <div id="subscriber-list" class="divide-y divide-border text-sm"></div>
            <p class="text-muted-foreground text-xs mt-3">
              Open <a href="https://follow.it/publisher/dashboard" class="underline" target="_blank">follow.it dashboard</a> to manage emails
            </p>
          </div>
        </div>
      </section>

      <!-- Visitor Map -->
      <section>
        <h2 class='text-xl font-semibold text-foreground mb-4'>Visitors</h2>
        <p class='text-muted-foreground text-sm mb-4'>Where people are reading from.</p>
        <VisitorMap />
      </section>

      <!-- Friends Grid -->
      <section>
        <h2 class='text-xl font-semibold text-foreground mb-4'>Friends</h2>
        {
          shuffled.length > 0 ? (
            <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4'>
              {shuffled.map((friend) => (
                <a
                  href={friend.link}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='flex items-center gap-x-4 rounded-xl border bg-muted p-4 transition-all hover:scale-[1.02] hover:shadow-lg'
                >
                  <img
                    src={friend.avatar}
                    alt={friend.name}
                    class='size-12 rounded-full shrink-0 bg-background object-cover'
                    loading='lazy'
                    onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Crect fill=%22%23e5e7eb%22 width=%22100%22 height=%22100%22 rx=%2220%22/%3E%3Ctext x=%2250%22 y=%2265%22 text-anchor=%22middle%22 font-size=%2240%22 fill=%22%239ca3af%22%3E%3F%3C/text%3E%3C/svg%3E'"
                  />
                  <div class='min-w-0'>
                    <div class='font-medium text-foreground truncate'>{friend.name}</div>
                    <div class='text-sm text-muted-foreground mt-0.5 line-clamp-1'>{friend.desc}</div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class='rounded-xl border bg-muted p-8 text-center text-muted-foreground text-sm'>
              No friends yet. <a href='mailto:hanying@ru00ys-lab.com' class='highlight'>Be the first?</a>
            </div>
          )
        }
      </section>

      <!-- Exchange Card -->
      <section>
        <h2 class='text-xl font-semibold text-foreground mb-4'>Want to exchange links?</h2>
        <div class='rounded-xl border bg-muted p-5 flex flex-col sm:flex-row items-center gap-x-5 gap-y-4'>
          <img
            src='/favicon/favicon.png'
            alt="Ru00y&apos;s Lab avatar"
            class='size-16 rounded-full shrink-0 border-2 border-border'
          />
          <div class='min-w-0 w-full grid grid-cols-1 gap-y-2 text-sm'>
            <div class='flex flex-col sm:flex-row sm:items-center gap-x-2'>
              <span class='text-muted-foreground shrink-0 w-16'>Name</span>
              <button class='copy-btn font-mono text-foreground cursor-pointer hover:text-primary transition-colors text-left' data-copy="Ru00y&apos;s Lab">Ru00y&apos;s Lab</button>
              <span class='copied-toast hidden text-xs text-green-500'>Copied!</span>
            </div>
            <div class='flex flex-col sm:flex-row sm:items-center gap-x-2'>
              <span class='text-muted-foreground shrink-0 w-16'>Desc</span>
              <button class='copy-btn font-mono text-foreground cursor-pointer hover:text-primary transition-colors text-left' data-copy="Licensed to Wander">Licensed to Wander</button>
              <span class='copied-toast hidden text-xs text-green-500'>Copied!</span>
            </div>
            <div class='flex flex-col sm:flex-row sm:items-center gap-x-2'>
              <span class='text-muted-foreground shrink-0 w-16'>Link</span>
              <button class='copy-btn font-mono text-foreground cursor-pointer hover:text-primary transition-colors text-left break-all' data-copy="https://ru00ys-lab.com/">https://ru00ys-lab.com/</button>
              <span class='copied-toast hidden text-xs text-green-500'>Copied!</span>
            </div>
            <div class='flex flex-col sm:flex-row sm:items-center gap-x-2'>
              <span class='text-muted-foreground shrink-0 w-16'>Avatar</span>
              <button class='copy-btn font-mono text-foreground cursor-pointer hover:text-primary transition-colors text-left break-all' data-copy="https://ru00ys-lab.com/favicon/favicon.png">https://ru00ys-lab.com/favicon/favicon.png</button>
              <span class='copied-toast hidden text-xs text-green-500'>Copied!</span>
            </div>
          </div>
        </div>
        <div class='mt-4 text-sm text-muted-foreground space-y-3'>
          <p>
            This little corner of the web is always open to new friends.
            <a href='mailto:hanying@ru00ys-lab.com' class='highlight'>Send over your info</a>
            and I'll put you on this wall.
          </p>
          <p>
            No blog? A GitHub profile is just as welcome. Just knowing someone's out there reading this — that means a lot.
          </p>
          <div class='rounded-lg border bg-background p-3 font-mono text-xs leading-relaxed'>
            Name: Your name / site name<br />
            Link: https://your-blog-or-github.com<br />
            Avatar: https://your-site.com/avatar.png<br />
            Desc: A short one-liner about you
          </div>
        </div>
      </section>

      <!-- Comments -->
      <section>
        <h2 class='text-xl font-semibold text-foreground mb-4'>Wanna Email-free?</h2>
        <p class='text-muted-foreground text-sm mb-4'>Leave a comment below — name, link, avatar, a little about yourself. I'll see it and add you.</p>
        <Comment />
      </section>

    </div>
  </main>
</PageLayout>

<script>
  // Copy-to-clipboard buttons
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).dataset.copy
      if (text) {
        navigator.clipboard.writeText(text)
        const toast = (btn as HTMLElement).nextElementSibling as HTMLElement
        if (toast) {
          toast.classList.remove('hidden')
          setTimeout(() => toast.classList.add('hidden'), 1500)
        }
      }
    })
  })

  // Email validation
  const form = document.querySelector('form')
  const emailInput = document.getElementById('email') as HTMLInputElement
  const errorEl = document.getElementById('email-error') as HTMLElement

  form?.addEventListener('submit', (e) => {
    errorEl.classList.add('hidden')
    emailInput.classList.remove('border-red-500')

    if (!emailInput.value.trim()) {
      e.preventDefault()
      errorEl.textContent = 'Please enter your email address.'
      errorEl.classList.remove('hidden')
      emailInput.classList.add('border-red-500')
      return
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
      e.preventDefault()
      errorEl.textContent = 'Please enter a valid email address.'
      errorEl.classList.remove('hidden')
      emailInput.classList.add('border-red-500')
      return
    }

    // Dual-submit mirror to Worker for owner dashboard
    fetch('https://api.ru00ys-lab.com/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: emailInput.value.trim() }),
    }).catch(() => {})
  })

</script>

<script is:inline>
  // Owner auth & subscriber panel
  ;(function () {
    const panel = document.getElementById('subscriber-panel')
    const list = document.getElementById('subscriber-list')
    const countEl = document.getElementById('subscriber-count')
    if (!panel || !list || !countEl) return

    const params = new URLSearchParams(window.location.search)
    const auth = params.get('auth')

    if (auth) {
      window.history.replaceState({}, '', window.location.pathname)
    }

    if (auth !== 'ok') return

    fetch('https://api.ru00ys-lab.com/me', { credentials: 'include' })
      .then(function (r) { return r.json() })
      .then(function (d) {
        if (!d.ok) return
        return fetch('https://api.ru00ys-lab.com/subscribers', { credentials: 'include' })
          .then(function (r) { return r.json() })
          .then(function (data) {
            if (!data.ok) return
            render(data.subscribers, data.count)
          })
      })
      .catch(function () {})

    function render(subscribers, count) {
      panel.classList.remove('hidden')
      countEl.textContent = count + ' subscriber' + (count !== 1 ? 's' : '')

      if (!subscribers.length) {
        list.innerHTML =
          '<div class="py-3 text-muted-foreground text-center">No subscribers yet.</div>'
        return
      }

      var html = ''
      var formatter = new Intl.RelativeTimeFormat('en', { numeric: 'auto' })
      for (var i = 0; i < subscribers.length; i++) {
        var s = subscribers[i]
        var ago = ''
        if (s.time) {
          var diff = Math.round((Date.now() - s.time) / 1000)
          if (diff < 60) ago = 'just now'
          else if (diff < 3600) ago = formatter.format(-Math.round(diff / 60), 'minute')
          else if (diff < 86400) ago = formatter.format(-Math.round(diff / 3600), 'hour')
          else ago = formatter.format(-Math.round(diff / 86400), 'day')
        }
        html +=
          '<div class="flex items-center gap-x-3 py-2.5">' +
          '<span class="font-mono text-xs text-foreground flex-1 truncate">' +
          escapeHtml(s.email) +
          '</span>' +
          '<span class="text-muted-foreground text-xs shrink-0">' +
          ago +
          '</span>' +
          '</div>'
      }
      list.innerHTML = html
    }

    function escapeHtml(str) {
      var div = document.createElement('div')
      div.textContent = str
      return div.innerHTML
    }
  })()
</script>

<style>
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 80% 70%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
