---
import { PFSearch } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'Search' }}>
  <main class='flex w-full flex-col items-center py-12'>
    <div class='w-full animate flex flex-col items-center gap-y-8 md:w-4/5 lg:w-5/6'>
      <div class='text-center'>
        <h1 class='text-3xl font-bold mb-2'>Search</h1>
        <p class='text-muted-foreground'>Find posts and pages across the site.</p>
      </div>
      <PFSearch />
    </div>
  </main>
</PageLayout>

<style>
  h1 { font-family: 'Newsreader', Georgia, serif; font-weight: 600; letter-spacing: -0.02em; }
  p { font-family: 'Spectral', Georgia, 'Times New Roman', serif; }
</style>
