---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'

const languages = ['Python', 'C', 'C++']
const ai = ['PyTorch', 'YOLO', 'VLM', 'Transformers', 'OpenGL', 'STM32']

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col items-center'>
    <!-- Hero -->
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-48 w-auto rounded-full border-2 p-1 shadow-lg'
        style='border-color: hsl(var(--primary) / 0.5);'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold gradient-text'>Ru00y's Lab</h1>
        <div class='text-muted-foreground text-lg flex items-center gap-2'>
          <span>🎸</span> VLM Researcher & Mio Fan <span>🎸</span>
        </div>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <a
            href='https://github.com/rua103'
            target='_blank'
            class='flex flex-row items-center gap-x-2 hover:text-primary transition-all'
          >
            <svg aria-hidden='true' class='size-5' width='22' height='22' viewBox='0 0 24 24' fill='currentColor'>
              <path d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'/>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <div class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm'>
        <span class='relative flex items-center justify-center'>
          <span class='absolute size-2 animate-ping rounded-full opacity-75'
                style='background: hsl(var(--primary));'></span>
          <span class='size-2 rounded-full' style='background: hsl(var(--primary));'></span>
        </span>
        <p class='font-medium text-muted-foreground'>🎸 Currently pushing code & bass lines...</p>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='✦ About'>
        <div class='mio-quote mb-2'>"Don't say lazy" — Akiyama Mio ♪</div>
        <p class='text-muted-foreground leading-7'>
          VLM researcher, Mio fan, bass enthusiast.
          Building models that see and read.
        </p>
        <Button title='More about me ♪' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      {allPostsByDate.length > 0 && (
        <Section title='♪ Posts'>
          <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
            {allPostsByDate.map((p) => (
              <li class='flex flex-col gap-x-2 sm:flex-row'>
                <PostPreview post={p} />
              </li>
            ))}
          </ul>
          <Button title='More posts ♪' class='w-fit self-end' href='/blog' variant='ahead' />
        </Section>
      )}

      <Section title='★ Publications'>
        <a
          href='https://openreview.net/forum?id=IVuhnkQQYr'
          target='_blank'
          class='not-prose block relative rounded-2xl border bg-muted px-5 py-3 transition-all hover:border-foreground/25 hover:shadow-sm'
        >
          <span class='inline-block w-fit rounded-full bg-primary/12 text-primary text-xs font-semibold px-2 py-0.5'>
            ECCV 2026
          </span>
          <h3 class='text-foreground font-semibold mt-1.5'>
            DegEval: Benchmarking and Understanding Visual Degradation in Vision-Language Models
          </h3>
          <p class='text-muted-foreground text-sm mt-1'>
            Jintao Gu, Guoshun Nan, Kaixiang Pan, <strong class='text-foreground'>Hanying Fu</strong>, et al.
          </p>
        </a>
      </Section>

      <Section title='🛠️ Projects'>
        <div class='flex flex-col gap-y-2'>
          <a href='https://github.com/rua103/Disaster-detection' target='_blank'
             class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
            <span class='text-lg'>🔥</span>
            <span class='font-medium text-foreground'>Disaster Detection</span>
            <span class='text-muted-foreground text-xs'>— YOLO-based slope disaster detector</span>
          </a>
          <a href='https://github.com/rua103/smart-security-alarm' target='_blank'
             class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
            <span class='text-lg'>🛡️</span>
            <span class='font-medium text-foreground'>Smart Security Alarm</span>
            <span class='text-muted-foreground text-xs'>— STM32 multi-sensor alarm system</span>
          </a>
          <a href='https://github.com/rua103/StructuredNounCaption' target='_blank'
             class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
            <span class='text-lg'>📝</span>
            <span class='font-medium text-foreground'>Structured Noun Caption</span>
            <span class='text-muted-foreground text-xs'>— Noun-guided image captioning</span>
          </a>
          <a href='https://github.com/rua103/Umich-pytorch' target='_blank'
             class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
            <span class='text-lg'>🧠</span>
            <span class='font-medium text-foreground'>Michigan DL for CV</span>
            <span class='text-muted-foreground text-xs'>— EECS 498-007 full coursework</span>
          </a>
          <a href='/projects' class='btn w-fit self-end mt-1'>All projects ♪ →</a>
        </div>
      </Section>

      <Section title='♩ Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='AI / ML' skills={ai} />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>

<style>
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 80% 70%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
