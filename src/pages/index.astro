---
import PostPreview from '@/components/PostPreview.astro'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import SidebarLayout from '@/components/mio/SidebarLayout.astro'
import { Comment } from '@/components/giscus'

const MAX_POSTS = 3
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const publications = [
  {
    title: 'DegEval: Benchmarking and Understanding Visual Degradation in Vision-Language Models',
    authors: 'Jintao Gu, Guoshun Nan, Kaixiang Pan, Hanying Fu, et al.',
    venue: 'ECCV 2026',
    url: 'https://openreview.net/forum?id=IVuhnkQQYr',
    status: 'under revision for TIP after ECCV 2026 submission'
  }
]
---

<PageLayout meta={{ title: 'Home' }} sidebar>
  <SidebarLayout>
    <!-- Identity -->
    <section class='animate mb-10' id='content-header'>
      <p class='ns-eyebrow'>VLM Research &middot; Field Notes</p>
      <h1 class='ns-page-title'>Hey, I'm Ru00y.</h1>
      <p class='ns-lede'>
        I work on vision-language models — building systems that see and read.
        This is my lab notebook: papers, projects, and late-night thoughts.
      </p>
      <div class='flex gap-3 mt-5'>
        <a href='/blog' class='ns-cta'>Read the blog</a>
        <a href='/about' class='ns-cta-ghost'>About me</a>
      </div>
    </section>

    <!-- Recent writing -->
    {allPostsByDate.length > 0 && (
      <section class='animate mb-10' id='content'>
        <div class='ns-section-head'>
          <h2 class='ns-section-title'>Recent writing</h2>
          <a href='/blog' class='ns-section-link'>All posts</a>
        </div>
        <ul class='flex flex-col gap-y-1.5'>
          {allPostsByDate.map((p) => (
            <li>
              <PostPreview post={p} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Publication highlight -->
    <section class='animate mb-10'>
      <div class='ns-section-head'>
        <h2 class='ns-section-title'>Research</h2>
        <a href='/publications' class='ns-section-link'>All publications</a>
      </div>
      {publications.map(pub => (
        <a
          href={pub.url}
          target='_blank'
          class='not-prose block rounded-xl border bg-muted px-5 py-3.5 transition-all hover:border-primary/40 hover:shadow-sm'
        >
          <span class='inline-block rounded-full bg-primary/12 text-primary text-xs font-semibold px-2.5 py-0.5 mb-2'>
            {pub.venue}
          </span>
          <h3 class='hp-pub-title text-foreground leading-snug'>{pub.title}</h3>
          <p class='hp-pub-authors text-muted-foreground mt-2 leading-relaxed'>{pub.authors}</p>
        </a>
      ))}
    </section>

    <!-- Projects -->
    <section class='animate mb-10'>
      <div class='ns-section-head'>
        <h2 class='ns-section-title'>Projects</h2>
        <a href='/projects' class='ns-section-link'>All projects</a>
      </div>
      <div class='flex flex-col gap-y-2'>
        <a href='https://github.com/rua103/Disaster-detection' target='_blank'
           class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
          <span class='hp-proj-name text-foreground'>Disaster Detection</span>
          <span class='hp-proj-desc text-muted-foreground'>YOLO-based slope disaster detector</span>
        </a>
        <a href='https://github.com/rua103/smart-security-alarm' target='_blank'
           class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
          <span class='hp-proj-name text-foreground'>Smart Security Alarm</span>
          <span class='hp-proj-desc text-muted-foreground'>STM32 multi-sensor alarm system</span>
        </a>
        <a href='https://github.com/rua103/StructuredNounCaption' target='_blank'
           class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
          <span class='hp-proj-name text-foreground'>Structured Noun Caption</span>
          <span class='hp-proj-desc text-muted-foreground'>Noun-guided image captioning</span>
        </a>
        <a href='https://github.com/rua103/Umich-pytorch' target='_blank'
           class='not-prose flex items-center gap-x-3 rounded-xl border bg-muted px-4 py-2.5 transition-all hover:border-primary/40 hover:shadow-sm'>
          <span class='hp-proj-name text-foreground'>Michigan DL for CV</span>
          <span class='hp-proj-desc text-muted-foreground'>EECS 498-007 full coursework</span>
        </a>
      </div>
    </section>

    <!-- Guestbook -->
    <section id='guestbook' class='animate flex flex-col gap-y-5 mb-8'>
      <div class='flex flex-col gap-y-2'>
        <h2 class='ns-section-title mb-1'>Guestbook</h2>
        <p class='text-muted-foreground text-sm'>
          Leave a message — comments are powered by GitHub Discussions.
        </p>
      </div>
      <Comment />
    </section>
  </SidebarLayout>
</PageLayout>

<style>
  .ns-eyebrow {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: hsl(var(--primary));
    margin-bottom: 0.9rem;
  }
  .ns-page-title {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: pretty;
    color: hsl(var(--foreground));
  }
  .ns-lede {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    color: hsl(var(--muted-foreground));
    margin-top: 0.85rem;
    max-width: 42ch;
    line-height: 1.65;
  }
  .ns-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.2rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: hsl(var(--primary));
    color: hsl(var(--background));
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(.2,.7,.3,1);
  }
  .ns-cta:hover {
    background: hsl(var(--ring));
    transform: translateY(-2px);
    color: hsl(var(--background));
    box-shadow: 0 6px 22px hsl(var(--ring) / 0.3);
  }
  .ns-cta:active {
    transform: scale(0.98);
  }
  .ns-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    background: transparent;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(.2,.7,.3,1);
  }
  .ns-cta-ghost:hover {
    border-color: hsl(var(--ring) / 0.5);
    color: hsl(var(--ring));
    background: hsl(var(--ring) / 0.06);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px hsl(var(--ring) / 0.12);
  }
  .ns-cta-ghost:active {
    transform: scale(0.98);
  }
  .ns-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .ns-section-title {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .ns-section-link {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .ns-section-link:hover {
    color: hsl(var(--primary));
  }

  /* Card typography — match the rest of the page */
  .hp-pub-title {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .hp-pub-authors {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-size: 0.9rem;
  }
  .hp-proj-name {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1rem;
    font-weight: 500;
  }
  .hp-proj-desc {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-size: 0.85rem;
  }
</style>
