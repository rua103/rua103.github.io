---
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'Subscribe' }}>
  <main class='flex w-full flex-col items-center py-12'>
    <div class='w-full max-w-md animate flex flex-col items-center gap-y-8'>
      <div class='text-center'>
        <h1 class='text-3xl font-bold gradient-text mb-2'>Subscribe</h1>
        <p class='text-muted-foreground'>
          Get new posts delivered to your inbox
        </p>
      </div>

      <div class='w-full rounded-2xl border bg-muted p-6'>
        <form
          action="https://api.follow.it/subscription-form/NGxBMDlLU3o3MGZPNnRpZXJJNWcwaDIwTlhnYzJXaWQrUysycGpDY2hYRTZJOWR3VXVzOU9EUUVwTFY4dnJoZnpCN2RCV3NlVGlIU3lKekhLNTdJK3FJUmRobUo2SlJIbGw5SEtBY0lKdVl4ZE1yYW93VXAxR283K3VKUkk4cVd8VXRyRVlBTG52ZWRCTGptZ2VsREUzcWYxcEt4ZWs2L2c5cXFLRU9NOGE1VT0=/8"
          method="post"
          target="_blank"
          novalidate
        >
          <label
            for="email"
            class="block text-sm font-medium text-foreground mb-3 text-center"
          >
            Get new posts by email:
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            aria-describedby="email-error"
            placeholder="Enter your email"
            class="w-full h-11 rounded-lg border bg-background px-4 text-sm outline-none focus:border-primary transition-colors"
          />
          <p id="email-error" class="hidden text-red-500 text-xs mt-1.5 text-center"></p>
          <button
            type="submit"
            id="subscribe-btn"
            class="w-full h-11 mt-4 rounded-lg bg-foreground text-background font-semibold text-sm hover:opacity-85 transition-opacity"
          >
            Subscribe
          </button>
        </form>
        <p class="text-muted-foreground text-xs text-center mt-4">
          Powered by
          <a href="https://follow.it" class="underline" target="_blank">follow.it</a>
          · No spam, unsubscribe anytime.
        </p>
      </div>
    </div>
  </main>
</PageLayout>

<script>
  const form = document.querySelector('form')
  const emailInput = document.getElementById('email') as HTMLInputElement
  const errorEl = document.getElementById('email-error') as HTMLElement

  form?.addEventListener('submit', (e) => {
    errorEl.classList.add('hidden')
    emailInput.classList.remove('border-red-500')

    if (!emailInput.value.trim()) {
      e.preventDefault()
      errorEl.textContent = 'Please enter your email address.'
      errorEl.classList.remove('hidden')
      emailInput.classList.add('border-red-500')
      return
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
      e.preventDefault()
      errorEl.textContent = 'Please enter a valid email address.'
      errorEl.classList.remove('hidden')
      emailInput.classList.add('border-red-500')
      return
    }
  })
</script>

<style>
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 80% 70%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
