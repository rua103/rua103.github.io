---
import { Image } from 'astro:assets'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

const languages = ['Python', 'C', 'C++']
const ai = ['AI', 'MLLM', 'RL', 'Reasoning Model']

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(`"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`)
---

<PageLayout meta={{ title: 'About' }}>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-48 w-auto rounded-full border-2 p-1 shadow-lg'
        style='border-color: hsl(var(--primary) / 0.5);'
        loading='eager'
        fetchpriority='high'
      />
      <div>
        <h1 class='text-3xl font-bold text-center gradient-text'>♪ About Ru00y</h1>
        <p class='text-muted-foreground text-center mt-2'>The researcher behind the bass amp.</p>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='✦ Bio'>
        <div class='mio-quote mb-3'>
          "恥ずかしいセリフ禁止！" — Akiyama Mio ♪
        </div>
        <p class='text-muted-foreground leading-7'>
          Hey, I'm <strong class='text-foreground'>Ru00y</strong> ♪
          I'm an undergraduate student passionate about
          <strong class='text-foreground'>Vision-Language Models</strong> and multimodal AI.
          When I'm not training models or debugging CUDA errors,
          you'll find me listening to K-ON! and admiring Akiyama Mio.
        </p>
        <p class='text-muted-foreground leading-7 mt-2'>
          I believe in understanding things from the ground up — whether it's a neural
          network or a bass guitar riff. Just like Mio says: if you don't practice,
          you won't get better.
        </p>
      </Section>

      <Section title='★ Publications'>
        <a
          href='https://openreview.net/forum?id=IVuhnkQQYr'
          target='_blank'
          class='not-prose block relative rounded-2xl border bg-muted px-5 py-3 transition-all hover:border-foreground/25 hover:shadow-sm'
        >
          <span class='inline-block w-fit rounded-full bg-primary/12 text-primary text-xs font-semibold px-2 py-0.5 mb-2'>
            ECCV 2026
          </span>
          <h3 class='font-semibold'>DegEval: Benchmarking and Understanding Visual Degradation in Vision-Language Models</h3>
          <p class='text-muted-foreground text-sm mt-1'>
            Jintao Gu, Guoshun Nan, Kaixiang Pan, <strong>Hanying Fu</strong>, et al.
          </p>
        </a>
      </Section>

      <Section title='🎸 Currently'>
        <ul class='flex flex-col gap-y-2 text-muted-foreground' style='list-style:none;padding:0;'>
          <li>🎸 VLM robustness research</li>
          <li>📘 Studying algorithms (CLRS) & LeetCode</li>
          <li>💻 CS:APP labs & CS336 — Language Modeling from Scratch</li>
          <li>🎨 Computer Graphics — OpenGL & Path Tracing</li>
          <li>🎧 Replaying K-ON! for the Nth time</li>
        </ul>
      </Section>

      <Section title='♩ Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='AI / ML' skills={ai} />
      </Section>

      <Section title='✉️ Contact'>
        <p class='text-muted-foreground'>
          Find me on <a href='https://github.com/rua103' target='_blank' class='highlight'>GitHub</a> ♪
          I'm always happy to chat about research, coding, or K-ON!
        </p>
      </Section>
    </div>
  </main>
</PageLayout>

<style>
  .gradient-text {
    background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 80% 70%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
