---
import { Image } from 'astro:assets'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import SidebarLayout from '@/components/mio/SidebarLayout.astro'
import config from '@/site-config'

const languages = ['Python', 'C', 'C++']
const ai = ['AI', 'MLLM', 'RL', 'Reasoning Model']

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(`"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`)
---

<PageLayout meta={{ title: 'About' }} sidebar>
  <SidebarLayout>
    <section class='animate mb-8' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-32 w-auto rounded-full border-2 p-1 shadow-lg mb-5'
        style='border-color: hsl(var(--primary) / 0.5);'
        loading='eager'
        fetchpriority='high'
      />
      <h1 class='about-title'>About Ru00y</h1>
      <p class='about-sub'>VLM researcher. Builder. Music listener.</p>
    </section>

    <div id='content' class='animate flex flex-col gap-y-8'>
      <Section title='Bio'>
        <p class='text-muted-foreground leading-7'>
          Hey, I'm <strong class='text-foreground'>Ru00y</strong>. I'm an undergrad working on
          <strong class='text-foreground'>vision-language models</strong> and multimodal learning.
          When I'm not staring at training curves or untangling CUDA errors,
          I'm probably deep in a playlist.
        </p>
        <p class='text-muted-foreground leading-7 mt-2'>
          I believe in understanding things from first principles —
          whether it's deriving a transformer's attention mechanism from scratch,
          or figuring out why a kernel launch just silently returned garbage.
          The best way to learn is to build, break, and fix it yourself.
        </p>
        <p class='text-muted-foreground leading-7 mt-2'>
          When I'm not thinking about models, I'm navigating the beautiful chaos of
          <strong class='text-foreground'>EE and CS coursework</strong> —
          oscillating between struggling and actually enjoying it.
        </p>
      </Section>

      <Section title='Publications'>
        <a
          href='https://openreview.net/forum?id=IVuhnkQQYr'
          target='_blank'
          class='not-prose block rounded-2xl border bg-muted px-5 py-3 transition-all hover:border-foreground/25 hover:shadow-sm'
        >
          <span class='inline-block w-fit rounded-full bg-primary/12 text-primary text-xs font-semibold px-2 py-0.5 mb-2'>
            Under Revision for TIP
          </span>
          <h3 class='font-semibold'>DegEval: Benchmarking and Understanding Visual Degradation in Vision-Language Models</h3>
          <p class='text-muted-foreground text-sm mt-1'>
            Jintao Gu, Guoshun Nan, Kaixiang Pan, <strong>Hanying Fu</strong>, et al.
          </p>
        </a>
      </Section>

      <Section title='Interested'>
        <p class='text-muted-foreground leading-7'>
          I want to understand how intelligence works. Right now I'm focused on
          <strong class='text-foreground'>multimodal models</strong> that see, read, and reason.
          Longer-term, I'm drawn to <strong class='text-foreground'>interpretability</strong> —
          what happens when these systems scale past the point we can explain.
        </p>
        <p class='text-muted-foreground leading-7 mt-2'>
          I'd like to be around when AGI happens — not watching from the sidelines, but
          having contributed something real.
        </p>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='AI / ML' skills={ai} />
      </Section>

      <Section title='Contact'>
        <p class='text-muted-foreground leading-7'>
          Find me on <a href='https://github.com/rua103' target='_blank' class='highlight'>GitHub</a>,
          or reach me at <a href='mailto:hanying@ru00ys-lab.com' class='highlight'>hanying@ru00ys-lab.com</a>.
          I'm always happy to chat about research, coding, or music.
        </p>
      </Section>
    </div>
  </SidebarLayout>
</PageLayout>

<style>
  .about-title {
    font-family: 'Newsreader', Georgia, serif !important;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
    color: hsl(var(--foreground));
  }
  .about-sub {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  :global(#content h2) {
    font-family: 'Newsreader', Georgia, serif !important;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  :global(#content h3) {
    font-family: 'Newsreader', Georgia, serif !important;
    font-weight: 600;
  }
  :global(#content p), :global(#content li) {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif !important;
    font-size: 1.05rem;
    line-height: 1.75;
  }
</style>
