---
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import DarkModePopup from '@/components/DarkModePopup.astro'
import DockMagnify from '@/components/DockMagnify.astro'
import config from '@/site-config'

import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  /** Use sidebar layout — hides Header/Footer, uses v0 background + toggle */
  sidebar?: boolean
  /** Page has its own full-bleed hero art — suppress the fixed page-art layers */
  hero?: boolean
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor,
  sidebar = false,
  hero = false,
  ...props
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link href='https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Spectral:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap' rel='stylesheet' />
  </head>

  <body class={sidebar ? 'bg-background text-foreground' : 'flex justify-center bg-background text-foreground'} {...props}>
    <!-- Background art layers (v0 signature) — suppressed when page has its own hero art -->
    {!hero && (
      <>
        <div class='ns-art-bg' aria-hidden='true'></div>
        <div class='ns-art-veil' aria-hidden='true'></div>
      </>
    )}

    {sidebar ? (
      <slot />
    ) : (
      <div
        id='main-container'
        class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
      >
        <Header />
        <div class='flex-1 w-full'>
          <slot />
        </div>
        <Footer />
      </div>
    )}

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
    <DarkModePopup />
    <DockMagnify />
    <script is:inline>
      ;(() => {
        const hostname = window.location.hostname
        if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1') return

        if (window.location.search === '?login' || new URLSearchParams(window.location.search).has('login')) {
          window.location.href = 'https://api.ru00ys-lab.com/login'
          return
        }

        const key = 'ru00y:tracked-date'
        const now = new Date()
        const today = [now.getFullYear(), String(now.getMonth() + 1).padStart(2, '0'), String(now.getDate()).padStart(2, '0')].join('-')
        if (localStorage.getItem(key) === today) return

        fetch('https://api.ru00ys-lab.com/me', { credentials: 'include' })
          .then(r => r.json())
          .then(d => {
            if (d.ok) return
            localStorage.setItem(key, today)
            fetch('https://api.ru00ys-lab.com/track', { credentials: 'include' }).catch(() => {})
          })
          .catch(() => {})
      })()
    </script>
  </body>
</html>
