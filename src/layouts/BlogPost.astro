---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom } from 'astro-pure/components/pages'
import config from 'virtual:config'
import Copyright from '@/components/Copyright.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Comment } from '@/components/giscus'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment,
  tags
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()

const dateStr = publishDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
})
const minutesRead = remarkPluginFrontmatter.minutesRead as number | undefined
---

<PageLayout meta={{ articleDate, description, ogImage: socialImage, title }} sidebar hero>
  <!-- Full-bleed cinematic hero -->
  <header class='ns-hero'>
    <div class='ns-hero-art'></div>
    <div class='ns-hero-wash'></div>
    <div class='ns-hero-fade'></div>

    <div class='ns-topbar'>
      <a href='/' class='ns-mark'>Ru00y.</a>
      <nav class='ns-tracknav'>
        <a href='/blog'><span class='num'>01</span><span class='trk'>Writing</span></a>
        <a href='/projects'><span class='num'>02</span><span class='trk'>Projects</span></a>
        <a href='/publications'><span class='num'>03</span><span class='trk'>Publications</span></a>
        <a href='/about'><span class='num'>04</span><span class='trk'>About</span></a>
      </nav>
    </div>

    <div class='ns-hero-caption'>
      <div class='ns-hero-eyebrow'>
        {dateStr}{minutesRead ? ` · ${minutesRead}` : ''}
      </div>
      <h1 class='ns-hero-title'>{title}</h1>
      {description && <p class='ns-hero-lede'>{description}</p>}
    </div>
  </header>

  <!-- Reading surface: left-aligned article + sticky TOC sidebar -->
  <div class='ns-reader-wrapper'>
    <main class='ns-reader'>
      {tags && tags.length > 0 && (
        <div class='bp-meta'>
          {tags.map((tag: string) => (
            <a href={`https://en.wikipedia.org/wiki/${encodeURIComponent(tag)}`} target='_blank' rel='noopener noreferrer' class='bp-tag'>{tag}</a>
          ))}
        </div>
      )}
      <article class='prose'>
        <slot />
      </article>

      <!-- Bottom -->
      <div class='mt-10 space-y-6'>
        <Copyright {data} />
        <ArticleBottom collections={posts} {id} />
        {!isDraft && enableComment && (
          <>
            <div class='rounded-xl border bg-muted px-4 py-3 text-center'>
              <p class='text-muted-foreground text-sm'>
                Enjoyed this post? <a href='/connect' class='highlight font-medium'>Never miss out on future posts</a>
              </p>
            </div>
            <Comment />
          </>
        )}
      </div>
    </main>

    <aside class='ns-toc'>
      <p class='ns-toc-label'>On this page</p>
      {headings.length > 0 ? (
        <nav>
          <ul>
            {headings.map(h => (
              <li style={`padding-left: ${(h.depth - 2) * 0.6}rem`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <p class='ns-toc-empty'>No sections.</p>
      )}
    </aside>
  </div>
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<style>
  /* Reader + TOC layout */
  .ns-reader-wrapper {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }
  .ns-reader {
    flex: 1;
    min-width: 0;
  }
  .ns-toc {
    width: 12rem;
    flex-shrink: 0;
    position: sticky;
    top: 2.5rem;
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    padding: 0;
    display: none;
  }
  @media (min-width: 900px) {
    .ns-toc {
      display: block;
    }
  }
  .ns-toc-label {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground) / 0.45);
    margin-bottom: 0.6rem;
  }
  /* TOC sidebar — ghost text, no chrome */
  .ns-toc nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ns-toc nav li {
    margin: 0;
  }
  .ns-toc nav a {
    display: block;
    padding: 0.25rem 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 0.92rem;
    color: hsl(var(--muted-foreground) / 0.55);
    text-decoration: none;
    transition: color 0.25s ease;
    line-height: 1.45;
  }
  .ns-toc nav a:hover {
    color: hsl(var(--ring));
  }
  .ns-toc-empty {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 0.88rem;
    color: hsl(var(--muted-foreground) / 0.35);
    font-style: italic;
  }

  .bp-meta {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    margin-bottom: 2.25rem;
  }
  .bp-tag {
    padding: 0.2rem 0.55rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    text-decoration: none;
    color: hsl(var(--muted-foreground));
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .bp-tag:hover {
    border-color: hsl(var(--ring) / 0.6);
    color: hsl(var(--ring));
  }

  /* Editorial reader typography — authoritative, beats global .prose */
  .ns-reader article {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-size: 1.125rem;
    line-height: 1.8;
    color: hsl(var(--foreground));
  }
  .ns-reader article :global(p) {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.4rem;
    text-wrap: pretty;
  }
  .ns-reader article :global(p:first-of-type::first-letter) {
    float: left;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 3.3rem;
    font-weight: 600;
    line-height: 0.72;
    margin: 0.12rem 0.55rem 0 0;
    color: hsl(var(--primary));
  }
  .ns-reader article :global(h2) {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 2.4rem 0 0.9rem;
    color: hsl(var(--foreground));
  }
  .ns-reader article :global(h3) {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 1.9rem 0 0.7rem;
    color: hsl(var(--foreground));
  }
  .ns-reader article :global(ul),
  .ns-reader article :global(ol) {
    font-size: 1.125rem;
    line-height: 1.8;
    margin: 0 0 1.4rem 1.4rem;
  }
  .ns-reader article :global(li) {
    margin-bottom: 0.4rem;
  }
  .ns-reader article :global(blockquote) {
    border-left: 2px solid hsl(var(--ring) / 0.5);
    padding-left: 1.1rem;
    margin: 1.6rem 0;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .ns-reader article :global(a) {
    color: hsl(var(--primary));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--primary) / 0.35);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .ns-reader article :global(a:hover) {
    color: hsl(var(--ring));
    border-color: hsl(var(--ring) / 0.6);
  }
  .ns-reader article :global(code:not(pre code)) {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.9em;
    background: hsl(var(--muted));
    padding: 0.12rem 0.35rem;
    border-radius: 0.3rem;
  }
  .ns-reader article :global(img) {
    border-radius: 0.6rem;
    margin: 1.6rem 0;
  }

  /* Bottom sections — Copyright, ArticleBottom, follow prompt */
  .ns-reader :global(.text-sm),
  .ns-reader :global(.text-xs) {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif !important;
  }
  .ns-reader :global(.font-medium) {
    font-family: 'Newsreader', Georgia, serif !important;
  }
  .ns-reader :global(a.group) {
    font-family: 'Spectral', Georgia, 'Times New Roman', serif !important;
  }
</style>
