---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Hero, TOC } from 'astro-pure/components/pages'
import config from 'virtual:config'
import Copyright from '@/components/Copyright.astro'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment } from '@/components/giscus'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
    </Fragment>
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    { /* Follow prompt */ }
    <div class='mt-3 sm:mt-6 rounded-xl border bg-muted px-4 py-3 text-center'>
      <p class='text-muted-foreground text-sm'>
        Enjoyed this post? <a href='/connect' class='highlight font-medium'>Never miss out on future posts →</a>
      </p>
    </div>
    { /* Comment */
    !isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<style is:global>
  /* Drop cap — first letter of the first paragraph in a blog post */
  article > div:last-of-type > p:first-of-type::first-letter,
  article .prose > p:first-of-type::first-letter,
  #content > p:first-of-type::first-letter {
    float: left;
    font-size: 4.2rem;
    font-weight: 700;
    line-height: 0.75;
    margin-right: 0.55rem;
    padding-top: 0.08rem;
    color: hsl(var(--primary));
  }
</style>
